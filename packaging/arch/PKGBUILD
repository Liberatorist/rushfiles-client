# Maintainer: Liberatorist
pkgname=rfmount-bin
pkgver=0.2.2
pkgrel=1
pkgdesc="Unofficial Linux client for RushFiles: mount your shares as a network drive"
arch=('x86_64' 'aarch64')
url="https://github.com/Liberatorist/rushfiles-client"
license=('AGPL-3.0-only')
depends=('fuse3')
optdepends=('xdg-utils: open the browser for login')
options=('!strip')
_base="rushfiles-v${pkgver}-linux"
source_x86_64=("$url/releases/download/v$pkgver/$_base-amd64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_base-arm64.tar.gz")
sha256sums_x86_64=('5e0ac74cca4fc3f664db97d51b5083b5d280954050904de2328031c9c7930e87')
sha256sums_aarch64=('a8c5a705668f39a8c6695e9b63bc38929984386bd142c0d28c04709dae5501dc')

package() {
  local _arch=amd64
  [[ $CARCH == aarch64 ]] && _arch=arm64
  install -Dm755 "$_base-$_arch/rushfiles" "$pkgdir/usr/bin/rushfiles"
  install -Dm644 "$_base-$_arch/README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
}
